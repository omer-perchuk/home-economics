# -----------------------
# PostgreSQL (Docker)
# -----------------------
POSTGRES_USER=homeeconomics
POSTGRES_PASSWORD=homeeconomics
POSTGRES_DB=homeeconomics

# Database connection used by FastAPI
DATABASE_URL=postgresql://homeeconomics:homeeconomics@db:5432/homeeconomics

# -----------------------
# Frontend
# -----------------------
# API URL used by Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------
# Twilio / WhatsApp
# -----------------------
# Create a Twilio account and copy these values
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# WhatsApp sandbox number
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886