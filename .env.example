# -----------------------
# PostgreSQL (Docker)
# -----------------------
POSTGRES_USER=homeeconomics
POSTGRES_PASSWORD=homeeconomics
POSTGRES_DB=homeeconomics

# Database connection used by FastAPI
DATABASE_URL=postgresql://homeeconomics:homeeconomics@db:5432/homeeconomics

# -----------------------
# Frontend
# -----------------------
# API URL used by Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------
# WhatsApp Business API (Meta)
# -----------------------
META_ACCESS_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_phone_number_id
META_VERIFY_TOKEN=your_verify_token

# OpenAI
OPENAI_API_KEY=your_openai_api_key